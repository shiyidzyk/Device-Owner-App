<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 11+ 包可见性：允许检测 Shizuku 管理器（新旧两个包名均覆盖，
         新版见 rikka.shizuku.ShizukuProvider.MANAGER_APPLICATION_ID） -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="moe.shizuku.manager" />
    </queries>

    <application
        android:name=".App"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light">

        <!-- Dhizuku 客户端声明：API v3 -->
        <meta-data
            android:name="dhizuku.API_VERSION"
            android:value="3" />

        <!-- Shizuku binder 接收口：Shizuku server 启动后调用 sendBinder 把
             server binder 送达本 provider（文档要求 exported=true、
             permission 为 shell 特有权限、multiprocess=false，写法照 rikka.shizuku 源码 javadoc） -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Shizuku UserService：类会被 Shizuku server 从本 APK 加载，运行于 shell/root 身份 -->
        <service
            android:name=".ShellUserService"
            android:exported="false" />

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".AdminReceiver"
            android:description="@string/admin_desc"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
